# Copy to .env.local for development (Next.js loads it) and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# With DATABASE_URL unset the app runs in demo mode: bundled catalog, demo sign-in,
# progress and comments kept in the browser.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Any Postgres works (Neon, Supabase, Vercel Postgres, local).
# For serverless, use the provider's *pooled* URL here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mugenkai?sslmode=require"
# Direct (non-pooled) URL, used only by the Prisma CLI for migrations (poolers break its advisory locks).
# Neon: the same host without "-pooler". Leave unset when DATABASE_URL is already direct.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/mugenkai?sslmode=require"

# ── Sync jobs ───────────────────────────────────────────────────────────────
# Shared secret for /api/cron/*. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=""

# How many of the most popular titles to keep in the catalog (AniList popularity order).
SYNC_TOP_ANIME=50
SYNC_TOP_MANGA=50

# MangaDex asks API clients to identify themselves. Put a contact URL or email here.
MANGADEX_USER_AGENT="Mugenkai/1.0 (+https://github.com/your-name/mugenkai)"

# ── Accounts ────────────────────────────────────────────────────────────────
# Comma-separated emails that get the ADMIN role when they register.
ADMIN_EMAILS=""

# ── Email (password reset) ──────────────────────────────────────────────────
# Resend API key (https://resend.com/api-keys). Unset in development: reset links are logged to the console.
RESEND_API_KEY=""
# Sender. Must be on a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend address.
EMAIL_FROM="Mugenkai <no-reply@your-domain.com>"
# Public site origin used in emailed links. Set this in production.
APP_URL="https://your-domain.com"
