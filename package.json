{
  "name": "mugenkai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Anime/manga streaming and reading platform. Single Next.js app.",
  "homepage": "https://github.com/Flavius-Pantucu/mugenkai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flavius-Pantucu/mugenkai.git"
  },
  "license": "ISC",
  "author": "Flavius Pantucu",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && ([ \"$VERCEL_ENV\" != production ] || prisma migrate deploy) && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "catalog:demo": "node scripts/fetch-catalog.mjs",
    "catalog:fetch": "node scripts/fetch-catalog.mjs"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp"
    ]
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@hookform/resolvers": "^7.0.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "anime-sdk": "^1.1.0",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "embla-carousel-react": "^8.6.0",
    "got-scraping": "^4.2.2",
    "hls.js": "^1.7.4",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "5"
  }
}
