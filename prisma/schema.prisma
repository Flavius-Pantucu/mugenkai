// Merged from the former auth, user, anime and manga service schemas.
// UserAuth + UserProfile + UserPreferences are folded into one User table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReleaseStatus {
  ONGOING
  COMPLETED
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String
  role                 Role     @default(USER)
  username             String   @unique
  avatarUrl            String?
  bio                  String?
  preferredGenres      String[]
  language             String   @default("en")
  matureContentEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  watchHistory   WatchHistory[]
  readingHistory ReadingHistory[]
}

model Anime {
  id          String        @id @default(uuid())
  title       String
  description String
  coverImage  String
  bannerImage String?
  trailerUrl  String?
  releaseDate DateTime?
  status      ReleaseStatus @default(ONGOING)
  rating      Float?        @default(0)
  createdAt   DateTime      @default(now())

  episodes Episode[]
}

model Episode {
  id            String @id @default(uuid())
  animeId       String
  episodeNumber Int
  title         String
  videoUrl      String
  duration      Int

  anime        Anime          @relation(fields: [animeId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@unique([animeId, episodeNumber])
}

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String
  episodeId String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model Manga {
  id          String        @id @default(uuid())
  title       String
  description String
  coverImage  String
  bannerImage String?
  status      ReleaseStatus @default(ONGOING)
  rating      Float?        @default(0)
  createdAt   DateTime      @default(now())

  chapters Chapter[]
}

model Chapter {
  id            String @id @default(uuid())
  mangaId       String
  chapterNumber Int
  title         String

  manga          Manga            @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  pages          Page[]
  readingHistory ReadingHistory[]

  @@unique([mangaId, chapterNumber])
}

model Page {
  id         String @id @default(uuid())
  chapterId  String
  imageUrl   String
  pageNumber Int

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
}

model ReadingHistory {
  id        String @id @default(uuid())
  userId    String
  chapterId String
  lastPage  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}
