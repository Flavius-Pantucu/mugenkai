// Mugenkai data model. Catalog rows are written by the sync jobs (src/server/sync),
// user rows by the API routes (src/app/api). Ids for series/episodes/chapters are
// deterministic (AniList id based) so URLs and browser-saved progress stay valid.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SeriesKind {
  ANIME
  MANGA
}

enum ReleaseStatus {
  ONGOING
  COMPLETED
}

/// Where a title sits in the user's list. CURRENT = watching (anime) / reading (manga).
enum ListStatus {
  CURRENT
  PLANNING
  COMPLETED
  PAUSED
  DROPPED
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          Role     @default(USER)
  avatarUrl     String?
  bio           String   @default("")
  matureContent Boolean  @default(false)
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  episodeProgress EpisodeProgress[]
  chapterProgress ChapterProgress[]
  comments        Comment[]
  likes           CommentLike[]
  list            ListEntry[]
}

/// id is the SHA-256 of the cookie token, so a leaked database cannot be replayed as sessions.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog (written by sync jobs) ─────────────────────────────────────────

/// One anime franchise or one manga. id = AniList id of the first season / the manga.
model Series {
  id               String        @id
  kind             SeriesKind
  malId            Int?
  mangadexId       String?       @unique
  title            String
  nativeTitle      String
  description      String
  coverImage       String
  bannerImage      String
  color            String?
  status           ReleaseStatus
  rating           Float
  popularity       Int
  year             Int
  genres           String[]
  // anime
  studio           String?
  episodeDuration  Int?
  trailerYoutubeId String?
  // manga
  author           String?
  volumeCount      Int?
  createdAt        DateTime      @default(now())
  syncedAt         DateTime      @updatedAt

  seasons     Season[]
  episodes    Episode[]
  chapters    Chapter[]
  links       StreamingLink[]
  listEntries ListEntry[]

  @@index([kind, popularity(sort: Desc)])
}

/// A TV season. id = that season's AniList id.
model Season {
  id           String  @id
  seriesId     String
  number       Int
  title        String
  year         Int
  episodeCount Int
  coverImage   String
  bannerImage  String
  airing       Boolean @default(false)

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([seriesId, number])
}

/// id = "<seriesId>-s<season>-e<number>".
model Episode {
  id           String    @id
  seriesId     String
  seasonId     String
  seasonNumber Int
  number       Int
  title        String
  thumbnail    String
  duration     Int
  airedAt      DateTime?

  series   Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season   Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  links    StreamingLink[]
  progress EpisodeProgress[]

  @@unique([seasonId, number])
  @@index([seriesId])
}

/// id = "<seriesId>-ch-<number>". Pages are fetched live from MangaDex, never stored.
model Chapter {
  id                String    @id
  seriesId          String
  number            Float
  title             String
  pageCount         Int
  mangadexChapterId String?   @unique
  /// Set when MangaDex only links to an official reader (e.g. MANGA Plus).
  externalUrl       String?
  scanlationGroup   String?
  publishedAt       DateTime?

  series   Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  progress ChapterProgress[]

  @@unique([seriesId, number])
}

/// Official places to watch: per series (AniList externalLinks) or per episode (streamingEpisodes).
model StreamingLink {
  id        String  @id @default(uuid())
  url       String  @unique
  provider  String
  language  String?
  seriesId  String?
  episodeId String?

  series  Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([episodeId])
}

// ─── User activity ──────────────────────────────────────────────────────────

model EpisodeProgress {
  userId    String
  episodeId String
  progress  Float
  updatedAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt(sort: Desc)])
}

model ChapterProgress {
  userId    String
  chapterId String
  page      Int
  pageCount Int
  updatedAt DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([userId, updatedAt(sort: Desc)])
}

/// threadId: "anime:<id>" | "manga:<id>" | "episode:<id>" | "chapter:<id>".
/// Deleting sets deletedAt so replies keep their parent (shown as "Comment deleted").
model Comment {
  id        String    @id @default(uuid())
  threadId  String
  parentId  String?
  userId    String
  body      String
  spoiler   Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("Replies")
  likes   CommentLike[]

  @@index([threadId, createdAt])
}

model CommentLike {
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

/// "Add to list", with a status (watching, planning, …).
model ListEntry {
  userId    String
  seriesId  String
  status    ListStatus @default(PLANNING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([userId, updatedAt(sort: Desc)])
}

// ─── Operations ─────────────────────────────────────────────────────────────

model SyncState {
  job       String    @id
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?
  summary   Json?
}
